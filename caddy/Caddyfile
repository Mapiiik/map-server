# The only way in: the cached tiles, the static map images and the embeddable map page.
#
# The PROXY protocol is always on, LISTENER_MODE picks how Caddy faces the world, see modes/.
# ACCESS_LOG=on logs every request.
{
	import modes/{$LISTENER_MODE:direct}/global.caddy

	# The PROXY protocol header is used when it comes from PROXY_ALLOW (by default this machine only)
	# and is optional there, from anywhere else it is ignored. So it stays on, with or without a proxy
	# in front, and nobody else can claim an address.
	servers {
		listener_wrappers {
			proxy_protocol {
				timeout 5s
				allow {$PROXY_ALLOW:127.0.0.1/32 ::1/128}
			}
			tls
		}
	}
}

{$SERVER_NAME:localhost} {
	import log/{$ACCESS_LOG:off}.caddy

	# /tiles/<layer>/webmercator/{z}/{x}/{y}.<png|jpeg>
	handle /tiles/* {
		rewrite * /mapproxy{uri}
		reverse_proxy mapproxy:80 {
			header_down Cache-Control "public, max-age={$TILE_MAX_AGE:86400}"
		}
	}

	# /static/{lng},{lat},{zoom}/{width}x{height}[@2x].png?marker={lng},{lat}|pin.png
	handle_path /static/* {
		rewrite * /styles/osm-bright/static{uri}
		reverse_proxy tileserver:8080 {
			header_down Cache-Control "public, max-age={$TILE_MAX_AGE:86400}"
		}
	}

	redir /embed /embed/ 308
	handle_path /embed/* {
		root * /srv/embed
		header Content-Security-Policy "frame-ancestors {$EMBED_FRAME_ANCESTORS:*}"
		encode zstd gzip
		file_server
	}

	handle {
		respond "Not found" 404
	}
}
