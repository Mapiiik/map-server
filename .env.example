# Copy to .env and adjust. Everything here is read by Docker Compose.

# --- How the server faces the internet ---------------------------------------------------------
# Standalone, Caddy publishes ports 80 and 443 itself:
COMPOSE_FILE=compose.yaml:compose.direct.yaml
# Behind a proxy that routes TLS by SNI and sends the PROXY protocol (e.g. HAProxy send-proxy-v2):
#COMPOSE_FILE=compose.yaml:compose.behind-proxy.yaml
#INGRESS_NETWORK=ingress
#INGRESS_ALIAS=maps_example_com
# Where the PROXY protocol header is trusted from: the proxy's network, see `docker network inspect`.
#PROXY_ALLOW=172.16.0.0/12

# On Windows, separate COMPOSE_FILE with ";" and set COMPOSE_PATH_SEPARATOR=";".
#COMPOSE_PROJECT_NAME=maps_example_com

# --- Public name --------------------------------------------------------------------------------
# The hostname the certificate is issued for; DNS must point at this server or at the proxy.
SERVER_NAME=maps.example.com

# Pages allowed to embed /embed/ in an iframe, as a CSP frame-ancestors list.
#EMBED_FRAME_ANCESTORS=https://www.example.com https://*.example.org

# How long browsers keep a tile, in seconds.
#TILE_MAX_AGE=86400

# on: log every request, client address included.
#ACCESS_LOG=off

# --- Data ----------------------------------------------------------------------------------------
# Where the extracts, the tiles and the cache live. Plan tens of gigabytes.
#DATA_DIR=./data

# Geofabrik regions to build the map of, separated by spaces, as in their download URLs.
REGIONS="europe/czech-republic"

# The builder checks daily and rebuilds once the tiles are older than UPDATE_MAX_AGE_DAYS.
#UPDATE_SCHEDULE="0 3 * * *"
#UPDATE_MAX_AGE_DAYS=30
#PLANETILER_HEAP=4g
#PLANETILER_ARGS=
#TZ=UTC

# --- Cache ---------------------------------------------------------------------------------------
# After each update the whole area is rendered ahead up to SEED_MAX_ZOOM, and the places in
# DATA_DIR/config/seed-coverage.geojson up to SEED_DETAIL_MAX_ZOOM.
#SEED_MAX_ZOOM=12
#SEED_DETAIL_MAX_ZOOM=16
#SEED_DETAIL_RADIUS_KM=3
#SEED_CONCURRENCY=4
# Tiles nobody asked for in CACHE_MAX_AGE_DAYS are removed on TRIM_SCHEDULE.
#CACHE_MAX_AGE_DAYS=90
#TRIM_SCHEDULE="30 4 * * 0"
#MAPPROXY_PROCESSES=4
#MAPPROXY_THREADS=8
